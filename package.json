{
  "name": "oru",
  "productName": "Oru",
  "desktopName": "oru.desktop",
  "description": "Harness-neutral desktop UI for coding agents",
  "author": "lencx <lencx.me@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lencx/Minke#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lencx/Minke.git"
  },
  "bugs": {
    "url": "https://github.com/lencx/Minke/issues"
  },
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.7.0",
  "main": ".vite/build/main.js",
  "scripts": {
    "icons:generate": "node scripts/forge/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build:product-packages": "node scripts/harness/build-product-packages.mjs",
    "build:preload": "vite build --config vite.preload.config.mts",
    "build:desktop:test": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build --config vite.renderer.config.mts",
    "test:desktop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-path-aliases.mts --test tests/standalone-runtime.test.mjs tests/standalone-packaging.test.mjs tests/standalone-tools.test.mjs tests/appimage-packaging.test.mjs tests/workspace-access.test.mjs tests/app-data-paths.test.mjs tests/oru-config.test.mjs tests/navigation-policy.test.mjs tests/terminal-tabs.test.mjs tests/terminal-settings.test.mjs tests/shortcut-binding.test.mjs tests/shortcut-i18n.test.mjs tests/shortcut-menu.test.mjs tests/shortcut-recording.test.mjs tests/shortcut-runtime.test.mjs tests/shortcut-settings.test.mjs tests/window-theme.test.mjs",
    "test:desktop:runtime": "pnpm run build:preload && electron tests/macos-window-runtime.cjs",
    "test:electron": "pnpm run build:desktop:test && node --test tests/electron/standalone-app.test.mjs",
    "verify": "pnpm typecheck && pnpm test:desktop && pnpm test:electron",
    "test:sys": "node --test tests/sys-native-module.test.mjs",
    "harness:verify": "node scripts/harness/verify.mjs",
    "harness:stage": "node scripts/harness/stage.mjs",
    "harness:stage:fast": "node scripts/harness/stage.mjs --skip-install --skip-build",
    "harness:size": "node scripts/harness/runtime-size.mjs",
    "harness:smoke": "node scripts/harness/smoke.mjs",
    "harness:smoke:packaged": "node scripts/harness/smoke.mjs --packaged",
    "start": "electron-forge start",
    "forge:package": "node --max-old-space-size=8192 scripts/forge/run.mjs package",
    "forge:make": "node --max-old-space-size=8192 scripts/forge/run.mjs make",
    "package": "pnpm run forge:package",
    "make": "pnpm run forge:make",
    "make:macos": "node scripts/forge/run.mjs make --platform=darwin"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-squirrel-startup": "1.0.1",
    "electron-window-state": "5.0.3",
    "node-pty": "1.2.0-beta.15",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "sys": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.2.0",
    "@lencx/minke-model-runtime": "workspace:*",
    "@lencx/minke-remote-access": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-winstaller": "5.4.4",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
